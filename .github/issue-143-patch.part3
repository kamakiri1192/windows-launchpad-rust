    """            &self.control_geometry_view,\n            &self.blur_view,""",
    """            &self.control_geometry_view,\n            &self.control_tint_view,\n            &self.blur_view,""",
)

single_geometry_target = """                targets: &[Some(wgpu::ColorTargetState {\n                    format: GEOMETRY_FORMAT,\n                    blend: None,\n                    write_mask: wgpu::ColorWrites::ALL,\n                })],"""
dual_geometry_target = """                targets: &[\n                    Some(wgpu::ColorTargetState {\n                        format: GEOMETRY_FORMAT,\n                        blend: None,\n                        write_mask: wgpu::ColorWrites::ALL,\n                    }),\n                    Some(wgpu::ColorTargetState {\n                        format: TINT_FORMAT,\n                        blend: None,\n                        write_mask: wgpu::ColorWrites::ALL,\n                    }),\n                ],"""
replace("src/liquid_glass/renderer.rs", single_geometry_target, dual_geometry_target)

badge_geometry_target = """                    targets: &[Some(wgpu::ColorTargetState {\n                        format: GEOMETRY_FORMAT,\n                        blend: None,\n                        write_mask: wgpu::ColorWrites::ALL,\n                    })],"""
badge_dual_geometry_target = """                    targets: &[\n                        Some(wgpu::ColorTargetState {\n                            format: GEOMETRY_FORMAT,\n                            blend: None,\n                            write_mask: wgpu::ColorWrites::ALL,\n                        }),\n                        Some(wgpu::ColorTargetState {\n                            format: TINT_FORMAT,\n                            blend: None,\n                            write_mask: wgpu::ColorWrites::ALL,\n                        }),\n                    ],"""
replace("src/liquid_glass/renderer.rs", badge_geometry_target, badge_dual_geometry_target)

replace(
    "src/liquid_glass/renderer.rs",
    """            control_geometry_texture,\n            control_geometry_view,""",
    """            control_geometry_texture,\n            control_geometry_view,\n            control_tint_texture,\n            control_tint_view,""",
)
replace(
    "src/liquid_glass/renderer.rs",
    """            geometry_texture,\n            geometry_view,\n            overlay_geometry_texture,\n            overlay_geometry_view,""",
    """            geometry_texture,\n            geometry_view,\n            geometry_tint_texture,\n            geometry_tint_view,\n            overlay_geometry_texture,\n            overlay_geometry_view,\n            overlay_tint_texture,\n            overlay_tint_view,""",
)
replace(
    "src/liquid_glass/renderer.rs",
    """        self.geometry_texture = geometry_texture;\n        self.geometry_view = geometry_view;\n        self.overlay_geometry_texture = overlay_geometry_texture;\n        self.overlay_geometry_view = overlay_geometry_view;\n        self.control_geometry_texture = control_geometry_texture;\n        self.control_geometry_view = control_geometry_view;""",
    """        self.geometry_texture = geometry_texture;\n        self.geometry_view = geometry_view;\n        self.geometry_tint_texture = geometry_tint_texture;\n        self.geometry_tint_view = geometry_tint_view;\n        self.overlay_geometry_texture = overlay_geometry_texture;\n        self.overlay_geometry_view = overlay_geometry_view;\n        self.overlay_tint_texture = overlay_tint_texture;\n        self.overlay_tint_view = overlay_tint_view;\n        self.control_geometry_texture = control_geometry_texture;\n        self.control_geometry_view = control_geometry_view;\n        self.control_tint_texture = control_tint_texture;\n        self.control_tint_view = control_tint_view;""",
)
replace(
    "src/liquid_glass/renderer.rs",
    """        let swallowed = GlassShape::rounded_rect([500.0, 350.0], [100.0, 100.0], 30.0);\n        let fixed_control""",
    """        let swallowed = GlassShape::rounded_rect([500.0, 350.0], [100.0, 100.0], 30.0);\n        let tinted_swallowed = swallowed.with_tint(Some([1.0, 0.5, 0.25, 0.75]));\n        let fixed_control""",
)
replace(
    "src/liquid_glass/renderer.rs",
    """        assert!(!base_shape_may_affect_frame(swallowed, 0.0, frame, 26.0));\n        assert!(base_shape_may_affect_frame(fixed_control, 0.0, frame, 26.0));""",
    """        assert!(!base_shape_may_affect_frame(swallowed, 0.0, frame, 26.0));\n        assert!(base_shape_may_affect_frame(\n            tinted_swallowed,\n            0.0,\n            frame,\n            26.0\n        ));\n        assert!(base_shape_may_affect_frame(fixed_control, 0.0, frame, 26.0));""",
)

# Add the tint attachment to every geometry render pass. Overlay geometry is
# intentionally shared by several sequential lanes, matching the existing
# geometry texture reuse.
def add_tint_attachments(view: str, tint_view: str) -> None:
    old = f"""color_attachments: &[Some(wgpu::RenderPassColorAttachment {{\n                    view: &self.{view},\n                    depth_slice: None,\n                    resolve_target: None,\n                    ops: wgpu::Operations {{\n                        load: wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT),\n                        store: wgpu::StoreOp::Store,\n                    }},\n                }})],"""
    new = f"""color_attachments: &[\n                    Some(wgpu::RenderPassColorAttachment {{\n                        view: &self.{view},\n                        depth_slice: None,\n                        resolve_target: None,\n                        ops: wgpu::Operations {{\n                            load: wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT),\n                            store: wgpu::StoreOp::Store,\n                        }},\n                    }}),\n                    Some(wgpu::RenderPassColorAttachment {{\n                        view: &self.{tint_view},\n                        depth_slice: None,\n                        resolve_target: None,\n                        ops: wgpu::Operations {{\n                            load: wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT),\n                            store: wgpu::StoreOp::Store,\n                        }},\n                    }}),\n                ],"""
    replace_at_least("src/liquid_glass/renderer/frame.rs", old, new)


def add_nested_tint_attachment(view: str, tint_view: str) -> None:
    old = f"""color_attachments: &[Some(wgpu::RenderPassColorAttachment {{\n                        view: &self.{view},\n                        depth_slice: None,\n                        resolve_target: None,\n                        ops: wgpu::Operations {{\n                            load: wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT),\n                            store: wgpu::StoreOp::Store,\n                        }},\n                    }})],"""
    new = f"""color_attachments: &[\n                        Some(wgpu::RenderPassColorAttachment {{\n                            view: &self.{view},\n                            depth_slice: None,\n                            resolve_target: None,\n                            ops: wgpu::Operations {{\n                                load: wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT),\n                                store: wgpu::StoreOp::Store,\n                            }},\n                        }}),\n                        Some(wgpu::RenderPassColorAttachment {{\n                            view: &self.{tint_view},\n                            depth_slice: None,\n                            resolve_target: None,\n                            ops: wgpu::Operations {{\n                                load: wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT),\n                                store: wgpu::StoreOp::Store,\n                            }},\n                        }}),\n                    ],"""
    replace("src/liquid_glass/renderer/frame.rs", old, new)


add_tint_attachments("geometry_view", "geometry_tint_view")
add_tint_attachments("overlay_geometry_view", "overlay_tint_view")
add_nested_tint_attachment("control_geometry_view", "control_tint_view")

# ---------------------------------------------------------------------------
# WGSL shape layout and dual-render-target geometry output.
# ---------------------------------------------------------------------------
for shader in [
    "assets/shaders/liquid_glass_geometry.wgsl",
    "assets/shaders/liquid_glass_badge_geometry.wgsl",
]:
    replace(
        shader,
        """    // offset 64\n    motion: vec4<f32>,\n};""",
        """    // offset 64\n    motion: vec4<f32>,\n    // offset 80; alpha < 0 uses the global glass tint\n    tint: vec4<f32>,\n};""",
    )
